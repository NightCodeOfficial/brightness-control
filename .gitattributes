# Normalize text; keep Linux scripts as LF so shebangs work in the VM.
* text=auto

*.sh          text eol=lf
*.py          text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# Windows PowerShell can use CRLF
*.ps1         text eol=crlf
